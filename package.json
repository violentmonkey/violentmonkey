  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "gulp dev",
    "dev:mv3": "cross-env MV3=1 gulp dev",
    "build": "cross-env NODE_ENV=production gulp build",
    "build:mv3": "cross-env NODE_ENV=production MV3=1 gulp build",
    "build:selfHosted": "cross-env TARGET=selfHosted BETA=1 run-s build",
    "analyze": "cross-env RUN_ENV=analyze run-s build",
    "i18n": "gulp i18n",
    "copyI18n": "gulp copyI18n",
    "lint": "run-s lint:js lint:yml",
    "lint:js": "eslint --ext .js,.vue . --cache",
    "lint:yml": "gulp check",
    "test": "cross-env BABEL_ENV=test TEST=test jest test --maxWorkers=50%",
    "ci": "run-p lint test",
    "bumpVersion": "gulp bump",
    "bump": "run-s ci && gulp bump --commit",
    "preversion": "run-s ci",
    "version": "gulp bump --reset"
  },
